{
  "manifest_version": 3,
  "name": "Monochrome New Tab",
  "description": "A blank new tab in one flat color, matched to your browser toolbar in light and dark mode.",
  "version": "1.1",
  "version_name": "1.01",
  "minimum_chrome_version": "136",
  "homepage_url": "https://github.com/Roccobot/monochromenewtab",
  "permissions": ["storage"],
  "chrome_url_overrides": {
    "newtab": "newtab.html"
  },
  "options_ui": {
    "page": "options.html",
    "open_in_tab": true
  },
  "background": {
    "service_worker": "background.js"
  },
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  }
}
